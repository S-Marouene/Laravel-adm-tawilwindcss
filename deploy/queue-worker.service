[Unit]
Description=Laravel queue worker (notifications, broadcasts)
After=network.target mysql.service

[Service]
User=onpc
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/home/onpc/Laravel-adm-tawilwindcss
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
